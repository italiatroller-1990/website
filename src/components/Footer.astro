---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Licensed under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA</a> by Italia Troller! Do not use this content without crediting!!!
</footer>
<style>
	footer {
		margin-top: auto;
		padding: 2em 1em 6em 1em;
		background-color: var(--bg);
		color: var(--fg-muted);
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: var(--fg-muted);
	}
	.social-links a:hover {
		color: var(--fg-bright);
	}
	footer a {
		color: var(--accent);
	}
	footer a:hover {
		color: var(--fg-bright);
	}
</style>
