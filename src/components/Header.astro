---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
    <nav>
        <a class="brand" href="/">
            <img src="/favicon.png" alt="" />
            <span>{SITE_TITLE}</span>
        </a>

        <div class="internal-links">
            <HeaderLink href="/">Welcome!</HeaderLink>
            <HeaderLink href="/blog">Lifelogs</HeaderLink>
            <HeaderLink href="/guides">Guides</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
            <HeaderLink href="/about">About me</HeaderLink>
        </div>
    </nav>
</header>

<style>
    header {
        margin: 0;
        padding: 0 1em;
        background: var(--bg-darkest);
        box-shadow: 0 2px 8px rgba(var(--gray), 20%);
    }

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 4rem;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0;
        color: var(--black);
        text-decoration: none;
    }

    .brand img {
        width: 2rem;
        height: 2rem;
        flex-shrink: 0;
    }

    .brand span {
        font-size: 1rem;
        font-weight: 600;
        transition:
            color 0.2s ease,
            letter-spacing 0.3s ease;
    }

    .brand:hover span {
        color: var(--accent);
        letter-spacing: 3px;
    }

    .internal-links {
        display: flex;
        align-items: center;
    }

    .internal-links :global(a) {
        position: relative;
        padding: 1em 0.5em;
        color: var(--black);
        text-decoration: none;
        transition:
            color 0.2s ease,
            letter-spacing 0.3s ease;
    }

    .internal-links :global(a)::after {
        content: '';
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 0;
        height: 2px;
        background: var(--accent);
        transform: translateX(-50%);
        transition: width 0.3s ease;
    }

    .internal-links :global(a:hover) {
        color: var(--accent);
        letter-spacing: 3px;
    }

    .internal-links :global(a:hover)::after {
        width: 60%;
    }

    .internal-links :global(a.active)::after {
        width: calc(100% - 1em);
    }

    .internal-links :global(a.active:hover)::after {
        width: 60%;
    }

    @media (max-width: 720px) {
        nav {
            flex-direction: column;
            gap: 0.25rem;
            padding: 0.5rem 0;
        }

        .internal-links {
            width: 100%;
            justify-content: center;
            flex-wrap: wrap;
        }

        .internal-links :global(a) {
            padding: 0.75em 0.4em;
        }
    }
</style>