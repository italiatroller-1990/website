---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
	<main>
		<h1>Welcome to my website!</h1>
		<p>
			This site has been rewritten in Astro! Which means I will get more flexibility and expandability!
			But with one caveat: Socials has been moved to the <a href="/about">About</a> page!
		</p>
		<p>Hey, stranger(s)! If you have never heard of me in any way, go to <a href=/about>my About!</a></p>
	</main>
	<Footer />
	</body>
</html>
