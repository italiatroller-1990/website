---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('lifelogs')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
				background: rgb(var(--gray-light));
				border-radius: 8px;
				padding: 1.5rem;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			ul li:hover {
				transform: translateY(-2px);
				box-shadow: var(--box-shadow);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 1.9rem;
			}
			ul li img {
				margin-bottom: 1rem;
				border-radius: 8px;
				width: 100%;
				height: auto;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0 0 0.5rem 0;
				color: var(--fg-bright);
				line-height: 1.3;
			}
			.date {
				margin: 0;
				color: var(--fg-muted);
				font-size: 0.875rem;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				ul {
					gap: 1rem;
				}
				ul li {
					width: 100%;
					padding: 1rem;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.5rem;
				}
			}
			#description {
				color: var(--fg-muted);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Lifelogs</h1>
			<p id="description">It's where I write blog posts about my life, tech and gaming things!</p>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/lifelogs/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
